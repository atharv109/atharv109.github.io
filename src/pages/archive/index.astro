---
// archive/index.astro — buffer index of archived builds, in `order`.
// Title-only lines (archive entries carry empty taglines).
import PageLayout from '../../layouts/PageLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('archive', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<PageLayout title="archive-index">
  <ContentPage>
    <h1>archive-index</h1>
    {entries.map((e) => (
      <p>
        <Button href={`/archive/${e.id}/`} icon={'\u{F0219}'}>{e.data.title}</Button>
      </p>
      <p aria-hidden="true">&nbsp;</p>
    ))}
  </ContentPage>
</PageLayout>