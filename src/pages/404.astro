---
// 404.astro — hero-style buffer: lost-in-the-buffer line and a Return button;
// the meadow rain (ref §8.4: rain + flowers, bloom char ×) mounts below via
// scripts/ascii/meadow.ts. Reduced motion: rain runs without the intro
// choreography (§14), matching the home page.
import PageLayout from '../layouts/PageLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import Button from '../components/Button.astro';
---
<PageLayout title="404" description="Page not found — Atharv Mittal">
  <ContentPage disableMaxWidth>
    <div class="ascii-container" aria-hidden="true"></div>
    <p id="center-spacers" aria-hidden="true">&nbsp;</p>
    <h1>lost in the buffer</h1>
    <p aria-hidden="true">&nbsp;</p>
    <p class="cta-row"
      ><span class="cta-align"
        ><Button href="/" icon={'\u{F0A54}'}>Return to the meadow</Button></span
      ></p
    >
  </ContentPage>
</PageLayout>
<script>
  import { attachCentering } from '../scripts/center-content';
  import { startMeadow } from '../scripts/ascii/meadow';
  const content = document.querySelector('.content-lines');
  const container = document.querySelector('.ascii-container');
  if (content instanceof HTMLElement) attachCentering(content);
  if (container instanceof HTMLElement && content instanceof HTMLElement) {
    startMeadow(
      container,
      document.getElementById('main-content') ?? content,
    );
  }
</script>