---
// resume.astro — JUST the PDF (user round 2026-10-06: "remove everything
// except the pdf"): the document rendered page-by-page by <pdf-pages>
// (pdf.js, no viewer chrome), page number under each page on the RIGHT.
// The download chip and flowchart were removed per the same request; the
// exact file itself is still served at /resume/Atharv_Mittal_Resume_Full.pdf.
import PageLayout from '../layouts/PageLayout.astro';
import ContentPage from '../components/ContentPage.astro';

const PDF = '/resume/Atharv_Mittal_Resume_Full.pdf';
---
<PageLayout title="resume">
  <ContentPage>
    <h1>Resume</h1>
    <p>
      <a class="button" href={PDF} download>Download PDF ↓</a>
    </p>
    <pdf-pages data-src={PDF}></pdf-pages>
    <script>
      import '../scripts/pdf-pages';
    </script>
  </ContentPage>
</PageLayout>