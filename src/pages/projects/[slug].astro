---
// projects/[slug].astro — case-study buffer (ref §2.3 adapted): h1, h2 tagline,
// stack chips, frontmatter metrics as plain `value — label` lines, then the
// markdown body (## Highlights / ## Story / ## Stack) rendered into the
// editor rhythm by the remark plugin, links, and the next-project button.
import PageLayout from '../../layouts/PageLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import Button from '../../components/Button.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} description={entry.data.tagline}>
  <ContentPage>
    <h1>{entry.data.title}</h1>
    {entry.data.tagline ? (
      <h2>{entry.data.tagline}</h2>
    ) : (
      <h2 class="seo-only">{entry.data.title}</h2>
    )}
    <p aria-hidden="true">&nbsp;</p>
    <p class="stack-line">
      {entry.data.stack.map((t) => (
        <span class="button" style="color:var(--color-overlay1)">{t}</span>
      ))}
    </p>
    {entry.data.metrics.map((m) => (
      <>
        <p aria-hidden="true">&nbsp;</p>
        <p>{m.value} — {m.label}</p>
      </>
    ))}
    <Content />
    {entry.data.links.length > 0 && (
      <>
        <p aria-hidden="true">&nbsp;</p>
        <p aria-hidden="true">&nbsp;</p>
        <h2>Links:</h2>
        <p>
          {entry.data.links.map((l) => (
            <span><Button href={l.url} icon={'\u{F0337}'} color={l.color}>{l.label}</Button>{' '}</span>
          ))}
        </p>
      </>
    )}
    <p aria-hidden="true">&nbsp;</p>
    <p aria-hidden="true">&nbsp;</p>
    <p>
      <Button href={`/projects/${next.id}/`} icon={'\u{F0219}'}>Next project →</Button>
    </p>
  </ContentPage>
</PageLayout>