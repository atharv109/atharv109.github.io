---
// experience.astro — every entry on the resume as ONE serpentine timeline
// (user request: "add all the experience ... in a snake pattern"). The art is
// composed column-exact (tmp-snake.mjs output, pasted as ART) and rendered
// with set:html so Astro's template compiler never sees the '<' arrows as
// tags. Facts only from the resume. Lines snap to the 19px buffer grid;
// overflow-x on phones.
import PageLayout from '../layouts/PageLayout.astro';
import ContentPage from '../components/ContentPage.astro';

const ART = `  +------------------------------+
  |   cybersec club (2022-23)    |
  |    led it · owasp · cy100    |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |    tinyvulnscanner (2025)    |
                    |   500+ ports · 70% faster    |
                    +--------------+---------------+
                                   |
                 +<================+
                 |
  +------------------------------+
  |       centrient (2025)       |
  |    soc intern · 200+/day     |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |    protopaper (2026 jan)     |
                    |    hackathon · <2 minutes    |
                    +--------------+---------------+
                                   |
                 +<================+
                 |
  +------------------------------+
  |     buildora (2026 jan)      |
  |    founder · ~50 clients     |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |     gowda lab (2026 may)     |
                    |    ocr · 8 stages · 0.94     |
                    +--------------+---------------+
                                   |
                 +<================+
                 |
  +------------------------------+
  |      blinks (2026 jul)       |
  |      icu voice · 1 week      |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |    eleventh round (2026)     |
                    |      paid client build       |
                    +--------------+---------------+
                                   |
                 +<================+
                 |
  +------------------------------+
  |     vulnswarm-vex (2026)     |
  |   1st author · ICTAI subm.   |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |   prompt optimiser (2026)    |
                    |    groq 6-stage · 3 chats    |
                    +--------------+---------------+
                                   |
                 +<================+
                 |
  +------------------------------+
  |      crypton (2026 apr)      |
  |  co-founder & cto · 10 beta  |
  +------------------------------+
                 |
                 +================>+
                                   |
                    +--------------+---------------+
                    |      acctomatic (2026)       |
                    |    paddleocr · green/red     |
                    +--------------+---------------+
                                   |
                                   v

              (the snake ends — the loop continues in the resume)`;
---
<PageLayout title="experience">
  <ContentPage>
    <h1>Experience</h1>
    <p aria-hidden="true">&nbsp;</p>
    <p>every stop on the resume, wired as a snake — follow it down:</p>
    <p aria-hidden="true">&nbsp;</p>
    <pre
      class="exp-flow"
      aria-label="Serpentine timeline of experience: cybersecurity club, tinyvulnscanner, centrient soc intern, protopaper, buildora, gowda lab research, blinks, eleventh round, vulnswarm-vex first-author paper, prompt optimiser, crypton, acctomatic."
      set:html={ART}
    />
  </ContentPage>
</PageLayout>

<style>
  .exp-flow {
    display: block;
    font: inherit;
    line-height: var(--line-height);
    white-space: pre;
    color: var(--color-green);
    user-select: text;
    overflow-x: auto;
  }
</style>