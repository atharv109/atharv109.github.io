---
// experience.astro — every entry on the resume as ONE serpentine timeline
// (user request: "add all the experience ... in a snake pattern"). The art is
// composed column-exact (tmp-snake.mjs output, pasted as ART) and rendered
// with set:html so Astro's template compiler never sees the '<' arrows as
// tags. Facts only from the resume. Lines snap to the 19px buffer grid;
// overflow-x on phones.
import PageLayout from '../layouts/PageLayout.astro';
import ContentPage from '../components/ContentPage.astro';

const ART = `

 +---------+----------+   +--------------------+   +--------------------+   +--------------------+
 | cybersec club ·22  |==>|  tinyvulnscan ·25  |==>| centrient soc ·25  |==>| protopaper ·26 jan |
 |   led it · owasp   |   |     500+ ports     |   |  200+ alerts/day   |   | hackathon project  |
 |   cy100 session    |   | -70% faster · xss  |   | defender · mimecast|   | paper→lab · 2 mins |
 +--------------------+   +--------------------+   +--------------------+   +---------+----------+
                                                                                      |

 +--------------------+   +--------------------+   +--------------------+   +---------+----------+
 |   11th round ·26   |<==|   blinks ·26 jul   |<==| gowda lab ·26 may  |<==|  buildora ·26 jan  |
 | paid client build  |   |  icu voice · 1 wk  |   |   ocr · 8 stages   |   | founder · ~50 clts |
 |  role dashboards   |   | built with claude  |   |    recall 0.94     |   |    12 ai agents    |
 +---------+----------+   +--------------------+   +--------------------+   +--------------------+
           |

 +---------+----------+   +--------------------+   +--------------------+   +--------------------+
 | vulnswarm-vex ·26  |==>|   prompt-opt ·26   |==>|  crypton ·26 apr   |==>|   acctomatic ·26   |
 |  1st author paper  |   |    groq 6-stage    |   |  cofounder & cto   |   | founder · paddleocr|
 | ICTAI · under subm.|   | 3 ai chats · edge  |   | passkeys · 10 beta |   | green/red · tenants|
 +--------------------+   +--------------------+   +--------------------+   +---------+----------+
           |

                            (the snake ends — the loop continues in the resume)`;
---
<PageLayout title="experience">
  <ContentPage disableMaxWidth>
    <div class="exp-hero">
      <h1>Experience</h1>
      <p aria-hidden="true">&nbsp;</p>
      <pre
        class="exp-flow"
        aria-label="Serpentine timeline of experience: cybersecurity club, tinyvulnscanner, centrient soc intern, protopaper, buildora, gowda lab research, blinks, eleventh round, vulnswarm-vex first-author paper, prompt optimiser, crypton, acctomatic."
        set:html={ART}
      />
    </div>
  </ContentPage>
</PageLayout>

<script>
  // fit-art — the cqw sizing rendered too big on the user's machine ("way
  // too big make it fit the screen"); CSS can't see the RENDERED cell width
  // (font metrics/zoom/DPR vary). Metric probe via canvas measureText — NO
  // DOM footprint (a wide hidden span inside the pane blew the page's
  // scroll width) and pure font metrics, re-measured when the webfont
  // loads. Fit = largest font-size where the art fits BOTH pane width and
  // viewport height, floored at 14px (never smaller than the site's text).
  const art = document.querySelector<HTMLElement>('.exp-flow');
  const pane = document.querySelector<HTMLElement>('.content-lines');
  if (art && pane) {
    const rows = (art.textContent ?? '').split('\n');
    const widest = Math.max(...rows.map((r) => r.length)); // measure, don't assume
    const LH_RATIO = 1.357; // the 19:14 grid line ratio, by design
    const ctx2d = document.createElement('canvas').getContext('2d');
    let chPerEm = NaN;
    let raf = 0;
    const metrics = () => {
      if (!ctx2d) return;
      ctx2d.font = '100px "Iosevka Term NF", Iosevka, monospace';
      chPerEm = ctx2d.measureText('X'.repeat(widest)).width / widest / 100;
    };
    const fit = () => {
      if (!Number.isFinite(chPerEm) || chPerEm <= 0) return;
      raf = 0;
      const fsW = (pane.clientWidth - 8) / (widest * chPerEm); // -8: px rounding headroom
      const fsH = (window.innerHeight - 4 * 19) / (rows.length * LH_RATIO); // air: 2 rows top+bottom
      const fs = Math.max(14, Math.min(fsW, fsH, 64));
      art.style.fontSize = `${fs.toFixed(2)}px`;
    };
    const queueFit = () => {
      if (!raf) raf = requestAnimationFrame(fit);
    };
    metrics();
    fit();
    new ResizeObserver(queueFit).observe(pane);
    addEventListener('resize', queueFit);
    document.fonts?.ready
      ?.then(() => {
        metrics();
        queueFit();
      })
      .catch(() => {});
    document.fonts
      ?.load?.('1rem "Iosevka Term NF", monospace')
      ?.then(() => {
        metrics();
        queueFit();
      })
      ?.catch?.(() => {});
  }
</script>

<style>
  /* The snake covers the screen (fit-art fits it exactly; these are the
     pre-JS defaults + the centring frame). */
  .exp-hero {
    min-height: 100svh;
    min-width: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
  }
  .exp-hero h1 {
    margin-bottom: var(--line-height);
  }
  .exp-flow {
    display: block;
    font: inherit;
    font-size: 2.03cqw;
    line-height: 1.357em;
    white-space: pre;
    color: var(--color-green);
    user-select: text;
    max-width: 100%;
    overflow-x: auto; /* phone: floor keeps the art readable; panes internally */
    scrollbar-width: thin;
  }
  </style>