---
// PageLayout.astro — editor shell: head + boot script + sidebar + buffer slot.
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/layout.css';
import '../styles/components.css';
import Sidebar from '../components/Sidebar.astro';
import SiteSettings from '../components/SiteSettings.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Atharv Mittal — full-stack developer portfolio',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1c2225" />
    <title>{title} ~ Atharv Mittal</title>
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-title" content="Atharv Mittal" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/IosevkaTermNF-Regular.woff2"
    />
    <script is:inline>
      // Boot script — dependency-free, runs before any module or style paint.
      try {
        if (localStorage.getItem('am-theme') === 'Light')
          document.documentElement.dataset.theme = 'light';
        var fs = parseInt(localStorage.getItem('am-font-size'), 10);
        if (!Number.isNaN(fs)) {
          // harden (T12): junk/out-of-range persisted sizes must not reach CSSOM
          document.documentElement.style.fontSize = Math.min(Math.max(fs, 12), 20) + 'px';
        }
        if (window.self !== window.top) document.documentElement.dataset.embedded = '';
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('wave-pending');
          if (location.pathname === '/')
            document.documentElement.classList.add('intro-pending');
        }
        // Folder open-state restore, synchronous at parse time: defining the
        // element here means each <tree-folder> upgrades as the parser reaches
        // it, so folders are in their final open/closed state at first paint
        // (no flash from a deferred module). Server-side forced-open folders
        // (current branch) carry no data-persist and are untouched.
        var navOpen = {};
        try {
          navOpen = JSON.parse(localStorage.getItem('am-nav-open') || '{}') || {};
        } catch (e2) {}
        customElements.define(
          'tree-folder',
          class extends HTMLElement {
            connectedCallback() {
              if (this.hasAttribute('data-persist')) {
                var label = this.getAttribute('label');
                if (label && Object.prototype.hasOwnProperty.call(navOpen, label))
                  this.toggleAttribute('open', navOpen[label] === 'true');
                this.removeAttribute('data-persist');
              }
            }
          },
        );
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <button type="button" class="menu-button" aria-expanded="false">
      Menu <toggle-indicator aria-hidden="true"></toggle-indicator>
    </button>
    <Sidebar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteSettings />
    <trophy-drawer></trophy-drawer>
    <script>
      import '../scripts/tree-folder';
      import '../scripts/nav-tree';
      import '../scripts/line-numbers';
      import '../scripts/site-sidebar';
      import '../scripts/trophy-drawer';
      import { attachPopupInterceptor } from '../scripts/popup-window';
      import { initFeatureBlocks } from '../scripts/feature-block';
      import { initSiteSettings } from '../scripts/site-settings';
      import { runTextWave } from '../scripts/text-wave';
      import { attachHoverWave } from '../scripts/button-hover-wave';
      attachPopupInterceptor();
      initFeatureBlocks();
      initSiteSettings();
      attachHoverWave(document);

      // Arrival text wave (ref §5 arrival reveal + §7.3): fonts first (metrics
      // must be final before splitting), one rAF for layout, then split + play.
      // CRITICAL (T3 review contract): wave-pending MUST be removed even when
      // runTextWave throws, or the buffer stays hidden forever. Reduced motion
      // skips the split entirely.
      const el = document.querySelector('.content-lines');
      // A page whose intro choreography owns the arrival (home: intro-pending
      // at boot + startHome's guarded finally) waves its own CTA in §7.2.3 and
      // clears the pending classes itself — the generic wave here would lift
      // the hold early at ~0.2s via the zero-block path.
      const homeOwnsArrival = document.documentElement.classList.contains('intro-pending');
      if (el instanceof HTMLElement && homeOwnsArrival) {
        // Failsafe: if home's intro were somehow to strand the class (startHome
        // is fully guarded, this is belt), clear it late.
        setTimeout(() => document.documentElement.classList.remove('wave-pending'), 8000);
      } else if (el instanceof HTMLElement) {
        try {
          if (document.documentElement.classList.contains('wave-pending')) {
            await document.fonts.ready;
            await new Promise((r) => requestAnimationFrame(r));
            if (
              document.documentElement.classList.contains('wave-pending') &&
              !matchMedia('(prefers-reduced-motion: reduce)').matches
            ) {
              await runTextWave(el);
            }
          }
        } finally {
          document.documentElement.classList.remove('wave-pending');
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    padding: var(--pad-sm) var(--pad-md);
    background: var(--color-base);
    color: var(--color-text);
    z-index: 200;
  }
  .skip-link:focus-visible {
    top: 0;
  }

  .menu-button {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    z-index: 99;
    padding: var(--pad-sm);
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-subtext2);
    cursor: pointer;
  }
  .menu-button[aria-expanded='true'] {
    color: var(--color-subtext0);
  }
  toggle-indicator::after {
    content: '[+]';
  }
  .menu-button[aria-expanded='true'] toggle-indicator::after {
    content: '[-]';
  }
  @media (width <= 50rem) {
    .menu-button {
      display: block;
    }
  }

  /* Embedded (inside a popup iframe): no chrome, single column. */
  html[data-embedded] body {
    grid-template-columns: 1fr;
  }
  html[data-embedded] .sidebar,
  html[data-embedded] .menu-button {
    display: none;
  }

  /* Arrival choreography flags (revealed by later tasks' scripts). */
  html.wave-pending .content-lines {
    opacity: 0;
  }
  html.intro-pending .sidebar,
  html.intro-pending .menu-button {
    opacity: 0;
  }
</style>
